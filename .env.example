# Public origin used to construct the Google OAuth callback URL.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional. Defaults to ./auth.db.
BETTER_AUTH_DATABASE_PATH=./auth.db
